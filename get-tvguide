#!/usr/bin/env bash

# Configuration parameters
CONSOLE_MODE=0 # 1 will output to console
HDHOMERUN_IP="<< HDHOMERUN IP ADDRESS >>"
JELLYFIN_URL="<< JELLYFIN URL >>"
JELLYFIN_API="<< JELLYFIN API KEY >>"
JELLYFIN_CFG="/DATA/AppData/jellyfin/config/livetv.xml"
TVSCRIPT_DIR="/DATA/AppData/jellyfin/config/job/"
TVSCRIPT_LOG="/DATA/AppData/jellyfin/config/log/get-tvguide.log"

# Logging functions
log_entry() {
    local timestamp=$(date +'%Y-%m-%d %H:%M:%S.%3N %z')
    printf "[%s] [%s] %s\n" "$timestamp" "$1" "$2" >> "$TVSCRIPT_LOG"
}
log_dbg() { log_entry "DBG" "$1"; }
log_nfo() { log_entry "INF" "$1"; }
log_wrn() { log_entry "WRN" "$1"; }
log_err() { log_entry "ERR" "$1"; }

cd $TVSCRIPT_DIR
log_nfo "Updating TV Guide Data Provider XMLTV for Live TV..."

if (( $CONSOLE_MODE )); then
    clear # Clear console for fresh output
    echo "Console output: Enabled"
    echo "HDHomeRun IP: $HDHOMERUN_IP"
    echo "Jellyfin URL: $JELLYFIN_URL"
    echo "Jellyfin API Key: $JELLYFIN_API"
    echo "Jellyfin Config file: $JELLYFIN_CFG"
    echo "Script directory: $TVSCRIPT_DIR"
    echo "Script log file: $TVSCRIPT_LOG"
fi

# Fetch the HDHomeRun DeviceAuth token
DEVICE_AUTH=$(/usr/bin/curl -s "http://$HDHOMERUN_IP/discover.json" | /usr/bin/grep -Po '"DeviceAuth":"\K[^"]+')
if [ -z "$DEVICE_AUTH" ]; then
    log_err "TV Guide update failed fetching the HDHR DeviceAuth token"
    (( CONSOLE_MODE )) && echo "Error fetching the HDHomeRun DeviceAuth token"
    exit 1
fi
(( CONSOLE_MODE )) && echo "Fetched the HDHomeRun DeviceAuth token: $DEVICE_AUTH"

# Construct the SiliconDust XMLTV URL
GUIDE_URL="https://api.hdhomerun.com/api/xmltv?DeviceAuth=$DEVICE_AUTH"
(( CONSOLE_MODE )) && echo -e "Constructed the SiliconDust XMLTV URL:\n  $GUIDE_URL"

# Construct the authorization header for Jellyfin API
AUTH_HEADER="Authorization: MediaBrowser Token=\"$JELLYFIN_API\""
(( CONSOLE_MODE )) && echo -e "Constructed the authorization header for Jellyfin API:\n  $AUTH_HEADER"

# Fetch the TV Guide Data Provider ID
PROVIDER_ID=$(/usr/bin/grep -oP '(?<=<Id>)[a-f0-9]{32}(?=</Id>)' "$JELLYFIN_CFG" | tail -n 1)
if [ -z "$PROVIDER_ID" ]; then
    log_err "TV Guide update failed fetching the Data Guide Provider Id"
    (( CONSOLE_MODE )) && echo "Error fetching the TV Guide Data Provider ID"
    exit 1
fi
(( CONSOLE_MODE )) && echo "Fetched TV Guide Data Provider ID: $PROVIDER_ID"

# Update the provider entry in-place by matching the JSON Id field
STATUS_CODE=$(/usr/bin/curl -s -o /dev/null -w "%{http_code}" -X POST "$JELLYFIN_URL/LiveTv/ListingProviders?id=$PROVIDER_ID" -H "$AUTH_HEADER" -H "Content-Type: application/json" -d "{\"Id\":\"$PROVIDER_ID\",\"Type\":\"XMLTV\",\"Path\":\"$GUIDE_URL\",\"EnableTuners\":true}")
if [ "$STATUS_CODE" -eq 200 ] || [ "$STATUS_CODE" -eq 204 ]; then
    log_nfo "TV Guide Data Provider XMLTV was updated (status $STATUS_CODE)"
    (( CONSOLE_MODE )) && echo "TV Guide Data Provider XMLTV was updated (status $STATUS_CODE)"
else
    log_err "TV Guide Data Provider XMLTV update failed (status $STATUS_CODE)"
    (( CONSOLE_MODE )) && echo "TV Guide Data Provider XMLTV update failed (status $STATUS_CODE)"
    exit 1
fi
